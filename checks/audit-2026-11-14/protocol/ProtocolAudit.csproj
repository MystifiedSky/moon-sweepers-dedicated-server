<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The inventory provider is deliberately replaced by a test double. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../mod/MoonDedicated/*.cs" Exclude="../../../mod/MoonDedicated/Plugin.cs;../../../mod/MoonDedicated/Log.cs" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="22.7.31.1" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.793" />
    <PackageReference Include="Samboy063.Cpp2IL.Core" Version="2022.1.0-pre-release.13" />
  </ItemGroup>
</Project>
