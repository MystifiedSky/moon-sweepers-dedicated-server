<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../mod/MoonLoaderCompatibility/LoaderCompatibility.cs" />
    <Compile Include="../../mod/MoonDedicated/BuildVersion.cs" />
    <PackageReference Include="BepInEx.Preloader.Core" Version="6.0.0-be.793" />
  </ItemGroup>
</Project>
